APP_NAME="Durpalla API Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://apigw.durpalla.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Shared Durpalla database via host MySQL Router (read/write).
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=6446
DB_DATABASE=durpalla
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Host Redis (system service — not containerized).
REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379

# Host MongoDB (system service — optional, extension enabled in image).
# MONGODB_URI=mongodb://host.docker.internal:27017
# MONGODB_DATABASE=durpalla

# Docker / server (host nginx proxy_pass)
APIGW_PORT_1=8001
APIGW_PORT_2=8002
APIGW_PORT_3=8003
APIGW_PORT_4=8004

# Passport keys (set or mount storage/oauth-*.key)
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# OpenSearch, Firebase, payment gateways — copy from production .env as needed.
