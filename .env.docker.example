APP_NAME="Durpalla API Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://apigw.durpalla.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://admin.durpalla.com,https://durpalla.com,https://www.durpalla.com
GUEST_COOKIE_SECURE=true
GUEST_COOKIE_SAME_SITE=lax

# Shared Durpalla database via MySQL Router (read/write on 6446).
# Bridge-network containers cannot use 127.0.0.1 for DB — deploy script picks a reachable host.
# Force a host: DB_ROUTER_HOST=103.60.204.94
# Custom scan list: MYSQL_ROUTER_CANDIDATES="103.60.204.94 103.60.204.200 103.60.204.238"
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=6446
DB_WRITE_PORT=6446
DB_READ_PORT=6447
DB_DATABASE=durpalla
DB_USERNAME=
DB_PASSWORD=

# Host Redis — direct connection (local dev only).
# REDIS_CLIENT=phpredis
# REDIS_HOST=host.docker.internal
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Redis Sentinel — set in server .env only (/opt/durpalla-apigw/.env), NOT during docker build.
# REDIS_SENTINEL_ENABLED=true
# REDIS_CLIENT=predis
# REDIS_SENTINEL_SERVICE=mymaster
# REDIS_SENTINEL_1_HOST=103.60.204.94
# REDIS_SENTINEL_1_PORT=26379
# REDIS_SENTINEL_2_HOST=103.60.204.200
# REDIS_SENTINEL_2_PORT=26379
# REDIS_SENTINEL_3_HOST=103.60.204.238
# REDIS_SENTINEL_3_PORT=26379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis

# Host MongoDB (system service — optional, extension enabled in image).
# MONGODB_URI=mongodb://host.docker.internal:27017
# MONGODB_DATABASE=durpalla

# Docker / server (host nginx proxy_pass)
APIGW_PORT_1=8001
APIGW_PORT_2=8002
APIGW_PORT_3=8003
APIGW_PORT_4=8004

# Passport (customer auth via App\Models\User — run `php artisan passport:client --personal` on admin)
# AUTH_MODEL is ignored in apigw config/auth.php; keep keys and client ID in server .env only.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
# PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# OpenSearch, Firebase, payment gateways — copy from production .env as needed.
