APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use the same database as the main application (Durpalla). Do not run migrations here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=durpalla
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis Sentinel (production Docker / clustered Redis)
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_SERVICE=mymaster
REDIS_SENTINEL_1_HOST=127.0.0.1
REDIS_SENTINEL_1_PORT=26379
REDIS_SENTINEL_2_HOST=127.0.0.1
REDIS_SENTINEL_2_PORT=26379
REDIS_SENTINEL_3_HOST=127.0.0.1
REDIS_SENTINEL_3_PORT=26379

# Hotel: panel uploads are usually served from the main app, not the API host. Set the admin
# origin so `/storage/...` URLs in API JSON resolve (see config/hotel.php).
# HOTEL_IMAGE_PUBLIC_BASE_URL=https://admin.durpalla.com
# Weekday list for peak when no `hotel_peak_day_rules` row matches: 0=Sun … 6=Sat, e.g. Fri–Sat = 5,6.
# HOTEL_DEFAULT_PEAK_DAYS=5,6
# Legacy: months (1–12); not used by customer API after peak-day rules.
# HOTEL_MODULE_PEAK_MONTHS=11,12,1
# When auto-creating missing hotel_inventory rows, default units (mod_hr_* uses hotel_rooms.total_rooms).
# HOTEL_DEFAULT_INVENTORY_UNITS=10

# Trip search: OpenSearch / partner / cache (see config/trip_search.php)
OPENSEARCH_ENABLED=false
OPENSEARCH_BASE_URL=
OPENSEARCH_INDEX=durpalla_trip_schedules
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT=5
TRIP_SEARCH_CACHE_TTL=0
TRIP_PARTNER_API_ENABLED=false
TRIP_PARTNER_API_URL=
TRIP_PARTNER_CACHE_TTL=60

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
