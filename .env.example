APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,openobserve
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# OpenObserve / OpenTelemetry (observer.durpalla.com)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=durpalla-apigw
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OPENOBSERVE_ORG=default
OPENOBSERVE_EMAIL=admin@durpalla.com
OPENOBSERVE_INGESTION_TOKEN=

# Use the same database as the main application (Durpalla). Do not run migrations here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=durpalla
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Share session cookie across *.durpalla.com (leading dot).
SESSION_DOMAIN=.durpalla.com
# true in production HTTPS (defaults to true when APP_URL starts with https://)
SESSION_SECURE_COOKIE=true

# Browser origins allowed to call the API with credentials (comma-separated).
# Mobile native apps ignore CORS. Patterns also allow https://*.durpalla.com.
CORS_ALLOWED_ORIGINS=https://admin.durpalla.com,https://web.durpalla.com,https://durpalla.com,https://www.durpalla.com

# Guest cart cookie: Domain=.durpalla.com + SameSite=None; Secure so web.* can
# receive Set-Cookie from apigw.* on credentialed XHR (Lax is rejected cross-origin).
GUEST_COOKIE_DOMAIN=.durpalla.com
GUEST_COOKIE_SECURE=true
GUEST_COOKIE_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Must match Redis requirepass. Leave empty only when Redis has no auth.
REDIS_PASSWORD=
REDIS_PORT=6379
# Do not set REDIS_URL unless you include a host, e.g. redis://127.0.0.1:6379

# Redis Sentinel (production Docker / clustered Redis)
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_SERVICE=mymaster
REDIS_SENTINEL_1_HOST=127.0.0.1
REDIS_SENTINEL_1_PORT=26379
REDIS_SENTINEL_2_HOST=127.0.0.1
REDIS_SENTINEL_2_PORT=26379
REDIS_SENTINEL_3_HOST=127.0.0.1
REDIS_SENTINEL_3_PORT=26379

# User uploads on shared NFS + CDN (see durpalla-admin docs/SHARED_ASSETS_CDN.md)
# UPLOADS_PUBLIC_BASE_URL=https://assets.durpalla.com
# Hotel panel images (admin storage symlink): same CDN base (see config/hotel.php)
# HOTEL_IMAGE_PUBLIC_BASE_URL=https://assets.durpalla.com
# Weekday list for peak when no `hotel_peak_day_rules` row matches: 0=Sun … 6=Sat, e.g. Fri–Sat = 5,6.
# HOTEL_DEFAULT_PEAK_DAYS=5,6
# Legacy: months (1–12); not used by customer API after peak-day rules.
# HOTEL_MODULE_PEAK_MONTHS=11,12,1
# When auto-creating missing hotel_inventory rows, default units (mod_hr_* uses hotel_rooms.total_rooms).
# HOTEL_DEFAULT_INVENTORY_UNITS=10

# Trip search: OpenSearch / partner / cache (see config/trip_search.php)
OPENSEARCH_ENABLED=false
OPENSEARCH_BASE_URL=
OPENSEARCH_INDEX=durpalla_trip_schedules
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT=5
TRIP_SEARCH_CACHE_TTL=0
TRIP_PARTNER_API_ENABLED=false
TRIP_PARTNER_API_URL=
TRIP_PARTNER_CACHE_TTL=60

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser checkout only: redirect /payment/status to the web app after gateway callback.
# Mobile native apps should leave this unset (they poll payment APIs / deep links).
# FRONTEND_PAYMENT_STATUS_URL=https://web.durpalla.com/payment/result
